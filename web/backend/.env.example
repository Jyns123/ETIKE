# Copiar a .env (no se sube a git). scripts/init_app_db.py puede generarlo solo.

# Conexion de la app: rol etike_app, con permisos minimos (ver sql/app_schema.sql).
# NO es el superusuario postgres del pipeline.
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=homecredit
APP_DB_USER=etike_app
APP_DB_PASSWORD=cambiar

# Misma llave que HC_ENCRYPTION_KEY de pipeline/.env: descifra el detalle del
# score del titular (pgcrypto). Sin ella la app no arranca.
HC_ENCRYPTION_KEY=cambiar

# Llave HMAC para pseudonimizar a los demas clientes en "Comparate"
# (alias estable, pero imposible de revertir sin esta llave).
PSEUDONYM_KEY=cambiar

# Sesion: expira tras X minutos sin actividad, y siempre tras Y horas.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Origenes aceptados para peticiones que modifican estado (anti-CSRF).
ALLOWED_ORIGINS=https://localhost:8443,https://localhost:5173

# TLS (generados por scripts/gen_certs.py)
TLS_CERT=../certs/server.crt
TLS_KEY=../certs/server.key
HOST=127.0.0.1
PORT=8443
